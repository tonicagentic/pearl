{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "uniwind-types.d.ts",
    "../lib/usage/**/*.ts",
    "../lib/browser/tabs.ts",
    "../lib/browser/types.ts",
    "../lib/json-render/**/*.ts",
    "../lib/agent-todos.ts",
    "../lib/agent-mode-context.ts",
    "../lib/design/preview-kind.ts"
  ]
}
