{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "uniwind-types.d.ts",
    "../lib/usage/**/*.ts",
    "../lib/browser/tabs.ts",
    "../lib/browser/types.ts",
    "../lib/json-render/**/*.ts",
    "../lib/agent-todos.ts",
    "../lib/agent-mode-context.ts",
    "../lib/pearl-lane.ts",
    "../lib/waiting-label.ts",
    "../lib/design/preview-kind.ts",
    "../lib/chat/events.ts",
    "../lib/chat/eve-session-recovery.ts",
    "../lib/plugins/catalog.ts",
    "../lib/plugins/capabilities.ts",
    "../lib/connections/catalog.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "jest.setup.ts",
    "node_modules"
  ]
}


