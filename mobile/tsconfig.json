{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "uniwind-types.d.ts",
    "../lib/usage/**/*.ts",
    "../lib/browser/tabs.ts",
    "../lib/browser/types.ts",
    "../lib/json-render/**/*.ts",
    "../lib/agent-todos.ts",
    "../lib/agent-mode-context.ts",
    "../lib/pearl-lane.ts",
    "../lib/waiting-label.ts",
    "../lib/thread-activity.ts",
    "../lib/stream-thinking-state.ts",
    "../lib/design/preview-kind.ts",
    "../lib/design/file-preview.ts",
    "../lib/chat/events.ts",
    "../lib/chat/eve-session-recovery.ts",
    "../lib/chat/coder-receipt.ts",
    "../lib/watch/**/*.ts",
    "../lib/chat/message-day.ts",
    "../lib/chat/turn-timestamps.ts",
    "../lib/plugins/catalog.ts",
    "../lib/sandbox/settings.ts",
    "../lib/plugins/capabilities.ts",
    "../lib/connections/catalog.ts",
    "../lib/custom-agents/mark.ts",
    "../lib/custom-agents/types.ts",
    "../lib/library/artifact-kind.ts",
    "../lib/library/quote-text.ts",
    "../lib/automations/types.ts",
    "../lib/automations/schedule.ts"
  ],

  "exclude": [
    "**/__tests__/**",
    "jest.setup.ts",
    "node_modules"
  ]
}


