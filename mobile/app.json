{
  "expo": {
    "name": "Pearl",
    "slug": "pearl",
    "owner": "tonicagentic",
    "version": "0.1.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tonicagentic.pearl",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "webcredentials:pearl.diy",
        "webcredentials:pearl.tonicagentic.com"
      ],
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "com.apple.developer.associated-domains": [
          "webcredentials:pearl.diy",
          "webcredentials:pearl.tonicagentic.com"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.tonicagentic.pearl.shared"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Pearl uses the microphone so you can talk during a live conversation.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.tonicagentic.pearl",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pearl uses your photos so you can attach them in chat.",
          "cameraPermission": "Pearl uses the camera so you can take a photo and attach it in chat.",
          "microphonePermission": "Pearl uses the microphone so you can talk during a live conversation."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pearl uses the camera for optional live video and for photos you attach in chat.",
          "microphonePermission": "Pearl uses the microphone so you can talk during a live conversation.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Pearl uses the microphone so you can talk during a live conversation.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#111111",
          "defaultChannel": "default"
        }
      ],
      "./plugins/with-live-audio-session.js",
      "expo-apple-authentication",
      "expo-iap",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-updates",
      "expo-video",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.350590311352-1ee8ut2vddsj94q52a7i9bg0kjvkbdgc"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F7F7F8",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#141414"
          }
        }
      ]
    ],
    "scheme": "pearl",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/43ee6005-c5ac-4b8f-b463-5d910681956d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "pearlOta": "1",
      "eas": {
        "projectId": "43ee6005-c5ac-4b8f-b463-5d910681956d"
      }
    }
  }
}
