{
  "expo": {
    "name": "Pearl",
    "slug": "pearl",
    "owner": "tonicagentic",
    "version": "0.1.0-alpha.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tonicagentic.pearl",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Pearl uses the microphone so you can talk during a live conversation.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.tonicagentic.pearl",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pearl uses your photos so you can attach them in chat.",
          "cameraPermission": "Pearl uses the camera so you can take a photo and attach it in chat.",
          "microphonePermission": "Pearl uses the microphone so you can talk during a live conversation."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pearl uses the camera for optional live video and for photos you attach in chat.",
          "microphonePermission": "Pearl uses the microphone so you can talk during a live conversation.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Pearl uses the microphone so you can talk during a live conversation.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#111111",
          "defaultChannel": "default"
        }
      ],
      "./plugins/with-live-audio-session.js",
      "expo-asset",
      "expo-font",
      "expo-sharing"
    ],
    "scheme": "pearl",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43ee6005-c5ac-4b8f-b463-5d910681956d"
      }
    }
  }
}
