# Pearl (my-agent) origin used for better-auth email/password and session checks.
# Simulator: http://localhost:3000
# Device: http://<your-lan-ip>:3000
# Production: https://pearl.tonicagentic.com
EXPO_PUBLIC_PEARL_URL=http://localhost:3000

# Apple Team ID for the shared Keychain access group
# (TEAMID.com.tonicagentic.pearl.shared). Required for silent SSO with Pearl.
EXPO_PUBLIC_APPLE_TEAM_ID=
