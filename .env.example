# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: long-term memory in a private Vercel Blob store (any mode).
# Set by `pnpm exec eve integration setup file-memory`. Memory stays disabled on
# Vercel until one of these is present; generic BLOB_* variables are ignored.
EVE_MEMORY_BLOB_STORE_ID=
EVE_MEMORY_BLOB_WEBHOOK_PUBLIC_KEY=

# Primary production auth origin (OAuth callbacks, native CSRF stamp).
# Production: https://pearl.diy
BETTER_AUTH_URL=

# Google Sign-In (better-auth social + web buttons + mobile ID tokens).
# Create Web + iOS (+ Android) OAuth clients in the same Google Cloud project.
# GOOGLE_CLIENT_ID=           # Web client ID (also set NEXT_PUBLIC_GOOGLE_CLIENT_ID)
# GOOGLE_CLIENT_SECRET=       # Web client secret
# GOOGLE_IOS_CLIENT_ID=       # iOS client ID (bundle com.tonicagentic.pearl)
# GOOGLE_ANDROID_CLIENT_ID=   # Android client ID (optional)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=  # Same as GOOGLE_CLIENT_ID (shows web Continue with Google)

# Apple Sign In (web Service ID + native App ID / bundle).
# APPLE_CLIENT_ID=com.tonicagentic.pearl.web
# APPLE_APP_BUNDLE_IDENTIFIER=com.tonicagentic.pearl
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=           # .p8 PEM; use \n for newlines in env
# NEXT_PUBLIC_APPLE_CLIENT_ID= # Same as APPLE_CLIENT_ID (shows web Continue with Apple)

# Shared account Autofill (Pearl + Pearl Money). Required for AASA / Digital Asset Links.
# APPLE_TEAM_ID=XXXXXXXXXX
# ANDROID_CERT_FINGERPRINTS=AB:CD:...,EF:12:...
# Optional Pearl Money web origin trusted for better-auth
# FINANCE_APP_URL=https://money.example.com

# Pearl Money API (`/api/v1/*`) — finance schema via RLS role (not DATABASE_URL)
# FINANCE_DATABASE_URL=postgresql://finance_app:...@.../neondb?sslmode=require
# PEARL_OWNER_EMAIL=you@example.com
# ENCRYPTION_KEY= # ≥32 chars for SSNs / Plaid tokens
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_PRODUCTS=transactions
# CRON_SECRET= # Bearer secret for /api/cron/finance-daily (Vercel Cron)


# Optional: user-scoped Vercel Connect plugins (Better Auth production only).
# Create connectors with user authorization; see docs/setup-and-deploy.md.
GMAIL_CONNECTOR=
CALENDAR_CONNECTOR=
# AES-256 key for iCloud CalDAV app-specific passwords (32 bytes base64, or 64 hex chars).
# Generate: openssl rand -base64 32
ICLOUD_CALDAV_CREDENTIALS_KEY=
DRIVE_CONNECTOR=
SHEETS_CONNECTOR=
GITHUB_CONNECTOR=
VERCEL_CONNECTOR=
EXPO_CONNECTOR=
NEON_CONNECTOR=
BETTERSTACK_CONNECTOR=
XERO_CONNECTOR=
TEMPO_CONNECTOR=
# Required when TEMPO_CONNECTOR is set (no default host).
TEMPO_MCP_URL=
# Optional Sheets MCP endpoint override.
# SHEETS_MCP_URL=
SLACK_CONNECTOR=

# Hosted production billing (Stripe + Metronome). On by default whenever the
# app runs in database/production mode. Self-hosters who want persistence
# without Pearl invoices set PEARL_BILLING=off.
# PEARL_BILLING=off
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
METRONOME_API_TOKEN=
METRONOME_RATE_CARD_ID=
# Optional overrides for sandbox metering (cents per vCPU-minute).
# PEARL_SANDBOX_CENTS_PER_VCPU_MINUTE=
