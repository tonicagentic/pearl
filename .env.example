# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: long-term memory in a private Vercel Blob store (any mode).
# Set by `pnpm exec eve integration setup file-memory`. Memory stays disabled on
# Vercel until one of these is present; generic BLOB_* variables are ignored.
EVE_MEMORY_BLOB_STORE_ID=
EVE_MEMORY_BLOB_WEBHOOK_PUBLIC_KEY=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: user-scoped Vercel Connect plugins (Better Auth production only).
# Create connectors with user authorization; see docs/setup-and-deploy.md.
GMAIL_CONNECTOR=
CALENDAR_CONNECTOR=
DRIVE_CONNECTOR=
SHEETS_CONNECTOR=
GITHUB_CONNECTOR=
VERCEL_CONNECTOR=
XERO_CONNECTOR=
TEMPO_CONNECTOR=
# Required when TEMPO_CONNECTOR is set (no default host).
TEMPO_MCP_URL=
# Optional Sheets MCP endpoint override.
# SHEETS_MCP_URL=
SLACK_CONNECTOR=

# Hosted production billing (Stripe + Metronome). On by default whenever the
# app runs in database/production mode. Self-hosters who want persistence
# without Pearl invoices set PEARL_BILLING=off.
# PEARL_BILLING=off
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
METRONOME_API_TOKEN=
METRONOME_RATE_CARD_ID=
# Optional overrides for sandbox metering (cents per vCPU-minute).
# PEARL_SANDBOX_CENTS_PER_VCPU_MINUTE=
