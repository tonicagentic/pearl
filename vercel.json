{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm db:migrate && pnpm build",
  "crons": [
    {
      "path": "/api/cron/finance-daily",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/lists-daily",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/billing-reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 6 * * 0"
    }
  ]
}
