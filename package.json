{
  "name": "pearl",
  "version": "0.1.0-alpha.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "vercel env run -e production -- pnpm db:migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "sync:shared": "node scripts/sync-shared.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsgo --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "node --test --env-file-if-exists=.env.development.local tests/",
    "test:unit": "node --test --env-file-if-exists=.env.development.local tests/",
    "evals:behavior": "pnpm exec eve eval behavior",
    "evals:smoke": "pnpm exec eve eval behavior --tag smoke"
  },
  "dependencies": {
    "@assistant-ui/eve": "^0.0.17",
    "@assistant-ui/next": "^0.0.20",
    "@assistant-ui/react": "^0.15.19",
    "@assistant-ui/react-markdown": "^0.14.15",
    "@firecrawl/pdf-inspector": "^1.20.0",
    "@neondatabase/serverless": "1.1.0",
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/engine-oniguruma": "4.3.1",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "0.8.0",
    "@vercel/speed-insights": "2.0.0",
    "@xiangfa/mindmap": "^0.7.1",
    "ai": "7.0.84",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "eve": "^0.54.3",
    "lucide-react": "1.33.0",
    "mermaid": "^12.0.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.3.1",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-shimmer": "^0.4.13",
    "use-stick-to-bottom": "1.1.6",
    "vercel": "^59.16.0",
    "zod": "4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "0.31.10",
    "microsandbox": "^0.5.10",
    "typescript": "7.0.2"
  },
  "registries": {
    "@assistant-ui": "https://r.assistant-ui.com/{name}.json"
  }
}
